@startuml modelo_dados_psi
hide empty methods
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2C3E50
    HeaderBackgroundColor #ECF0F1
    FontColor #2C3E50
}

title Modelo de Dados do Backend - PSI (com.example.model)

package "com.example.model" {

    class Estado <<Entity>> {
        - id : Long <<PK, BIGSERIAL>>
        --
        - sigla : String <<VARCHAR(2), NOT NULL, UNIQUE>>
        - nome : String <<VARCHAR(100), NOT NULL>>
    }

    enum Regiao <<Enum>> {
        CENTRO_OESTE
        NORTE
        NORDESTE
        SUDESTE
        SUL
        --
        - id : Long
        - nome : String
    }

    class Municipio <<Entity>> {
        - id : Long <<PK, BIGSERIAL>>
        --
        - nome : String <<VARCHAR(60), NOT NULL>>
    }

    class Pessoa <<Entity>> {
        - id : Long <<PK, BIGSERIAL>>
        --
        - nome : String <<VARCHAR(120), NOT NULL>>
        - cpf : String <<VARCHAR(11), NOT NULL, UNIQUE>>
        - email : String <<VARCHAR(120), NOT NULL, UNIQUE>>
        - dataNascimento : LocalDate <<DATE, NOT NULL>>
        - genero : String <<VARCHAR(30)>>
        - endereco : String <<VARCHAR(255)>>
    }

    class Telefone <<Entity>> {
        - id : Long <<PK, BIGSERIAL>>
        --
        - codigoArea : String <<VARCHAR(3), NOT NULL>>
        - numero : String <<VARCHAR(15), NOT NULL>>
        - whatsapp : Boolean <<BOOLEAN, NOT NULL>>
    }

    class Paciente <<Entity>> {
        - id : Long <<PK, BIGSERIAL>>
        --
        - observacoes : String <<TEXT>>
        - ativo : Boolean <<BOOLEAN, NOT NULL>>
    }

    class Psicologo <<Entity>> {
        - id : Long <<PK, BIGSERIAL>>
        --
        - crp : String <<VARCHAR(20), NOT NULL, UNIQUE>>
        - especialidade : String <<VARCHAR(120), NOT NULL>>
        - bio : String <<TEXT>>
        - valorConsulta : BigDecimal <<NUMERIC(10,2), NOT NULL>>
        - duracaoConsulta : Integer <<INTEGER, NOT NULL>>
        - ativo : Boolean <<BOOLEAN, NOT NULL>>
    }

    class Usuario <<Entity>> {
        - id : Long <<PK, BIGSERIAL>>
        --
        - login : String <<VARCHAR(120), NOT NULL, UNIQUE>>
        - senha : String <<VARCHAR(255), NOT NULL>>
        - ativo : Boolean <<BOOLEAN, NOT NULL>>
    }

    enum Perfil <<Enum>> {
        ADMINISTRADOR
        ATENDENTE
        PACIENTE
        PSICOLOGO
        --
        - id : Long
        - nome : String
    }

    Municipio "0..*" --> "1" Estado : pertence a >
    Estado "0..*" --> "0..1" Regiao : classificado em >

    Pessoa "1" *-- "1..*" Telefone : possui >
    Pessoa "0..*" --> "0..1" Municipio : reside em >

    Paciente "0..1" --> "1" Pessoa : identifica-se como >
    Psicologo "0..1" --> "1" Pessoa : identifica-se como >
    Usuario "0..1" --> "1" Pessoa : vincula-se a >

    Usuario "0..*" --> "1..*" Perfil : possui >

}

note right of Estado
  **Tabela:** estado
  **Migrations:**
  - V1.0.0__Create_estado_table.sql
  - V1.0.1__adjust_legacy_estado_columns.sql
  - V1.0.3__Create_legacy_domain_tables.sql (uk_estado_sigla + regiao)
end note

note right of Municipio
  **Tabela:** municipio
  **Migrations:**
  - V1.0.2__Create_municipio_table.sql
end note

note bottom of Pessoa
  **Decisões de Domínio Aprovadas (V1.0.3):**
  1. POJOs JPA puros sem herança de DefaultEntity.
  2. Vínculo formal @ManyToOne entre Pessoa e Municipio (id_municipio), mantendo endereco complementar.
  3. Unicidades globais (cpf, email, crp, login, sigla) nesta etapa.
end note

@enduml
